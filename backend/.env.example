PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MOCK=true
# Shared token for approve/reject/counteroffer/draft/policy endpoints.
# Unset = open (local dev). Set it (any long random string) before hosting publicly,
# then send it as the X-Desk-Token header.
DESK_TOKEN=
# LLM provider: Anthropic is tried first, then OpenAI, then a deterministic template fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=8000
